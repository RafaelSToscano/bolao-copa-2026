# Copy this file to scripts/.env.clone and fill in the values.
# scripts/.env.clone is git-ignored (.env* is already in .gitignore).
#
# IMPORTANT — which connection string to use:
#   Supabase dashboard → Project settings → Database → Connection string
#   → pick **Session pooler** (NOT "Direct connection", NOT "Transaction pooler")
#
#   Direct connection (db.<ref>.supabase.co:5432) is IPv6-only and will fail
#   with "could not translate host name" on most networks.
#
#   Transaction pooler breaks pg_dump because it kills prepared statements
#   between calls. Only Session pooler works for backup + restore.
#
#   Session pooler URL shape:
#     postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- ORIGIN (prod, source of truth) ---
ORIGIN_DB_URL=

# --- DESTINATION (staging, will be WIPED) ---
DESTINATION_DB_URL=
